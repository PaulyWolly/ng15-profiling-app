.profile-image-section {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1rem;
}

.profile-image,
.profile-image-placeholder {
    width: 200px;
    height: 200px;
    border-radius: 50%;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: #f5f5f5;
    border: 2px solid #e0e0e0;
}

.profile-image {
    object-fit: cover;
}

.profile-image-placeholder mat-icon {
    font-size: 100px;
    width: 100px;
    height: 100px;
    color: #9e9e9e;
}

.image-upload {
    display: flex;
    gap: 1rem;
}

.preview-image {
    max-width: 200px;
    border-radius: 4px;
    margin-top: 10px;
}

.form-group {
    margin-bottom: 1rem;
}

.btn {
    margin-right: 0.5rem;
} 