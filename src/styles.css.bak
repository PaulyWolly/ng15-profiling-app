/* Add styles for the login, register, and forgot password pages */
.auth-container,
app-login,
app-register,
app-forgot-password,
app-verify-email,
app-reset-password {
    height: 100%;
    overflow: hidden !important;
}

/* Fix scrolling for the profile page by disabling mousewheel propagation */
/* Let the inner scrollable containers handle their own scrolling */
.profile-container,
.admin-container,
.auth-container {
    overscroll-behavior: contain;
}

/* Account pages should not have scrollbars */
.login-page .container,
.account-page .container {
    height: 100vh;
    overflow: hidden !important;
}

/* Special fix for account container to align center correctly without scrolling */
.account-page .container,
.login-page .container {
    display: flex;
    align-items: center;
    justify-content: center;
}

/* Special fix for account pages */
app-layout .container {
    height: 100vh;
    overflow: hidden !important;
}

/* FORMS AND ACCOUNT PAGES */
/* Completely disable scrolling on all account/form pages */
.account-layout,
app-account,
app-login,
app-register,
app-new-register,
app-reset-password,
app-forgot-password,
app-verify-email,
app-layout,
.account-layout .row,
.account-layout .col,
.account-layout form,
.form-container,
.auth-container {
    overflow: hidden !important;
    height: auto !important;
}

/* Remove scrollbars from all form containers */
form,
.form-container,
.auth-container,
.login-container,
.register-container,
.reset-container,
.forgot-container {
    overflow: hidden !important;
}

/* Remove scrollbars from all Bootstrap containers in form pages */
.account-layout .container,
.account-layout .container-fluid,
.login-page .container,
.login-page .container-fluid {
    overflow: hidden !important;
}

/* Ensure the html and body elements don't scroll */
html.login-page,
body.login-page,
html.account-page,
body.account-page {
    overflow: hidden !important;
}

/* Add default max-height to all forms to prevent scrolling */
form {
    max-height: calc(100vh - 200px);
}

/* Override for certain form elements that might need scrollbars */
.form-scrollable {
    overflow-y: auto !important;
    max-height: 300px;
}

/* Complete scroll prevention for certain pages */
.no-scroll {
    overflow: hidden !important;
    height: 100% !important;
    position: fixed !important;
    width: 100% !important;
}

html.no-scroll,
body.no-scroll {
    overflow: hidden !important;
    overscroll-behavior: none !important;
    position: fixed !important;
    width: 100% !important;
    height: 100% !important;
}

/* Hide scrollbars on form content */
.form-content {
    overflow: hidden !important;
}

/* Remove scrollbars from specific account components */
app-login .container,
app-register .container,
app-forgot-password .container,
app-reset-password .container,
app-verify-email .container {
    overflow: hidden !important;
}

/* Remove scrollbars from all form cards */
.card-body form {
    overflow: hidden !important;
}

/* Hide scrollbars on login and register containers */
.login-container,
.register-container,
.reset-container,
.forgot-container {
    overflow: hidden !important;
}

/* ADMIN EDIT PAGE */
app-add-edit,
app-add-edit form,
app-add-edit .container,
app-add-edit .container-fluid,
app-add-edit .row,
app-add-edit .col,
app-add-edit .col-md-4,
app-add-edit .col-md-8,
app-add-edit .scrollable-form-container {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
}

app-add-edit::-webkit-scrollbar,
app-add-edit *::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
}

/* PROFILE EDIT PAGE */
app-edit,
app-edit form,
app-edit .container,
app-edit .container-fluid,
app-edit .row,
app-edit .col,
app-edit .col-md-4,
app-edit .col-md-8,
app-edit .scrollable-form-container {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
}

app-edit::-webkit-scrollbar,
app-edit *::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
}

/* Ensure scrollbars don't appear at specific sizes */
@media (min-width: 768px) {
    body, html {
        overflow: hidden !important;
    }
    
    .container, .container-fluid {
        overflow: hidden !important;
    }
    
    /* Adjust scrollable container heights for different screen sizes */
    .scrollable-form-container {
        height: calc(100vh - 220px);
        margin-bottom: 80px; /* Extra margin for larger screens */
    }
}

@media (max-height: 800px) {
    /* For smaller height screens, reduce height even more */
    .scrollable-form-container {
        height: calc(100vh - 240px);
        margin-bottom: 80px;
    }
}

/* Target login pages specifically */
app-login,
app-login .login-container,
app-login .container,
app-login .row,
app-login .col,
app-login .login-card,
app-login form,
app-register,
app-register .container,
app-register .row,
app-register .col,
app-register .card,
app-register form,
app-forgot-password,
app-forgot-password .container,
app-forgot-password form,
app-reset-password,
app-reset-password .container,
app-reset-password form {
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
    overflow: hidden !important;
}

app-login::-webkit-scrollbar,
app-login *::-webkit-scrollbar,
app-register::-webkit-scrollbar,
app-register *::-webkit-scrollbar,
app-forgot-password::-webkit-scrollbar,
app-forgot-password *::-webkit-scrollbar,
app-reset-password::-webkit-scrollbar,
app-reset-password *::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
}

/* Force the main components to hide scrollbars */
app-root,
app-root > *,
.app-container,
.main-container,
.content-container {
    overflow: hidden !important;
    -ms-overflow-style: none !important;
    scrollbar-width: none !important;
}

app-root::-webkit-scrollbar,
app-root > *::-webkit-scrollbar,
.app-container::-webkit-scrollbar,
.main-container::-webkit-scrollbar,
.content-container::-webkit-scrollbar {
    display: none !important;
    width: 0 !important;
    height: 0 !important;
}

/* One last approach - hide all scrollbars at root level */
body::-webkit-scrollbar,
html::-webkit-scrollbar {
    display: none !important;
}

/* Final fix to ensure scrollbar doesn't extend below footer */
.fix-scrollbar-footer {
    position: fixed;
    bottom: 60px;
    right: 0;
    width: 20px;
    height: 60px;
    background-color: #ecedee;
    z-index: 999;
}

app-edit:after,
app-add-edit:after {
    content: "";
    position: absolute;
    bottom: 0;
    right: 0;
    width: 20px;
    height: 80px;
    background-color: #ecedee;
    z-index: 9999;
}

/* Simple scrollbar fix - ensure scrollbar doesn't extend below footer */
::-webkit-scrollbar {
    height: calc(100vh - 120px) !important; /* Limit scrollbar height */
}

/* Specifically for the scrollable areas in profile and admin edit */
.scrollable-form-container::-webkit-scrollbar,
app-edit .col-md-8::-webkit-scrollbar,
app-add-edit .col-md-8::-webkit-scrollbar {
    height: calc(100vh - 120px) !important; /* Limit scrollbar height */
    position: absolute !important;
    bottom: 80px !important; /* Keep space at bottom */
}

/* Restore footer visibility and sizing */
.footer, app-footer, footer, .footer-container {
    width: 100% !important;
    max-width: 100% !important;
    left: 0 !important;
    right: 0 !important;
    position: relative !important;
    display: block !important;
    box-sizing: border-box !important;
    margin-top: 10px !important;
    margin-left: 0 !important;
    margin-right: 0 !important;
    z-index: 50 !important;
    height: auto !important;
    min-height: 50px !important;
    padding: 10px 15px !important;
    background-color: #f8f9fa !important;
    border-top: 1px solid #dee2e6 !important;
    color: #212529 !important;
    visibility: visible !important;
    opacity: 1 !important;
}

/* Footer text visibility */
.footer *, app-footer *, footer * {
    visibility: visible !important;
    display: inherit !important;
    color: inherit !important;
    opacity: 1 !important;
}

/* Fix scrollbar width to ensure full visibility */
::-webkit-scrollbar {
    width: 10px !important; /* Standard width */
    height: 10px !important;
    display: block !important;
}

::-webkit-scrollbar-track {
    background: #f0f0f0;
    border-radius: 0;
}

::-webkit-scrollbar-thumb {
    background: #888;
    border-radius: 0;
    border: 0 !important; /* Remove border to ensure full width visibility */
}

/* Fix scrollbar in content areas */
.scrollable-form-container::-webkit-scrollbar,
app-edit .scrollable-form-container::-webkit-scrollbar,
app-add-edit .scrollable-form-container::-webkit-scrollbar {
    width: 10px !important;
    right: 0 !important;
    display: block !important;
    border: none !important;
}

/* Ensure scrollbar thumb is visible */
.scrollable-form-container::-webkit-scrollbar-thumb,
app-edit .scrollable-form-container::-webkit-scrollbar-thumb,
app-add-edit .scrollable-form-container::-webkit-scrollbar-thumb {
    background: #888 !important;
    border: none !important;
    width: 10px !important;
}

/* Further footer fixes to ensure content visibility */
footer, .footer, app-footer, .footer-container {
    display: block !important;
    visibility: visible !important;
    opacity: 1 !important;
    height: auto !important;
    min-height: 50px !important;
    overflow: visible !important;
    -ms-overflow-style: visible !important;
    scrollbar-width: none !important;
}

footer *, .footer *, app-footer *, .footer-container * {
    visibility: visible !important;
    display: inline-block !important;
    opacity: 1 !important;
    color: #333 !important;
    overflow: visible !important;
}

footer span, .footer span, app-footer span, footer p, .footer p, app-footer p,
footer a, .footer a, app-footer a {
    visibility: visible !important;
    display: inline-block !important;
    color: #333 !important;
    text-decoration: none !important;
    margin: 0 5px !important;
    font-size: 14px !important;
}

/* Override any hidden overflow */
html, body, app-root, .container, .container-fluid {
    overflow-x: hidden !important;
    overflow-y: auto !important;
}

/* Last resort to show footer */
body > app-root:after {
    display: none !important;
    content: none !important;
}

/* Make scrollbars fully visible - simple approach */
::-webkit-scrollbar {
    width: 8px !important;
    height: 8px !important;
}

::-webkit-scrollbar-track {
    background: #f0f0f0;
}

::-webkit-scrollbar-thumb {
    background: #888;
    border: none !important;
}

/* Pure footer fix - clean approach */
footer, .footer, app-footer {
    display: block !important;
    background-color: #f8f9fa !important;
    padding: 8px 0 !important;
    text-align: center !important;
    border-top: 1px solid #dee2e6 !important;
    position: fixed !important;
    bottom: 0 !important;
    left: 0 !important;
    right: 0 !important;
    height: auto !important;
    z-index: 1030 !important;
    width: 100% !important;
    box-sizing: border-box !important;
}

/* Remove ALL overflow hidden rules */
html, body, app-root, .container, .container-fluid, .content-container, .footer, footer, app-footer {
    overflow: visible !important;
}

/* Ensure scrollable areas don't extend to the footer */
.scrollable-form-container {
    height: calc(100vh - 120px) !important;
    max-height: calc(100vh - 120px) !important;
    overflow-y: auto !important;
    margin-bottom: 60px !important;
}

/* Simple fix for scrollbar display */
.scrollable-form-container::-webkit-scrollbar {
    width: 8px !important;
    visibility: visible !important;
    display: block !important;
    border: none !important;
    background-color: #f0f0f0 !important;
}

.scrollable-form-container::-webkit-scrollbar-thumb {
    background-color: #888 !important;
    border: none !important;
}

/* Final reset for footer - restore original exactly */
.footer {
    position: fixed !important;
    bottom: 0 !important;
    width: 100% !important;
    background-color: #f8f9fa !important;
    border-top: 1px solid #dee2e6 !important;
    color: #212529 !important;
    padding: 8px 0 !important;
    text-align: center !important;
    z-index: 1000 !important;
    font-size: 14px !important;
}

/* Ensure footer text is visible */
.footer span, .footer p, .footer a, 
app-footer span, app-footer p, app-footer a,
footer span, footer p, footer a {
    color: #212529 !important;
    visibility: visible !important;
    display: inline-block !important;
    margin: 0 !important;
}

/* Remove unwanted borders or lines */
.footer::before, .footer::after,
app-footer::before, app-footer::after,
footer::before, footer::after {
    display: none !important;
    content: none !important;
}

/* Make page content not overlap footer */
.page-container {
    margin-bottom: 60px !important;
    padding-bottom: 60px !important;
}

/* Ensure footer is above content but not too high in z-index */
.footer, app-footer, footer {
    z-index: 100 !important;
}

/* RESET ALL FOOTER AND SCROLLBAR STYLES TO ALLOW ORIGINAL APPEARANCE */
/* First, reset all the complicated overrides we added */
.footer, app-footer, footer, .footer-container,
.footer *, app-footer *, footer *,
body > app-root:after,
::-webkit-scrollbar, ::-webkit-scrollbar-track, ::-webkit-scrollbar-thumb,
.scrollable-form-container::-webkit-scrollbar, 
.scrollable-form-container::-webkit-scrollbar-track,
.scrollable-form-container::-webkit-scrollbar-thumb,
html, body, app-root, .container, .container-fluid, .content-container {
    all: revert;
}

/* SIMPLE, FOCUSED FIX: Just reduce scrollable content width to make room for scrollbar */
.scrollable-form-container {
    width: 98% !important;
    margin-right: 2% !important;
}

/* Allow reasonable bottom margin for footer */
.page-container {
    margin-bottom: 60px;
}

/* CLEAN STYLESHEET - Remove all footer-related styling */

/* The only global styles we need for fixing the scrollbar visibility issue */
.scrollable-form-container {
    width: 98% !important;
    margin-right: 2% !important;
}

/* Revert all footer-specific styling to let component handle it */
.footer, app-footer, footer, .footer-container,
.footer *, app-footer *, footer *,
.footer::before, .footer::after,
app-footer::before, app-footer::after,
footer::before, footer::after {
    all: revert;
} 