    padding: 2rem 1rem;
}
*/

/* Override bootstrap card styles - Keep if needed globally, otherwise remove */
/*
.card {
    background: transparent !important;
    border: none !important;
    box-shadow: none !important;
}
*/

/* Remove conflicting input/form-control styles */
